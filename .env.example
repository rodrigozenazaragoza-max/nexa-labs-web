# Supabase — crea un proyecto en https://supabase.com y copia estos valores de Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Monelo (o el gateway que elijas) — se llenan cuando tengas cuenta aprobada
MONELO_SECRET_KEY=
MONELO_WEBHOOK_SECRET=

# WhatsApp de soporte (fallback de pedidos, como hace Exoma)
NEXT_PUBLIC_WHATSAPP_NUMBER=5210000000000

# Panel de administración (/admin) — contraseña de acceso + token de sesión.
# Configúralos en Netlify (Site configuration > Environment variables).
ADMIN_PASSWORD=
ADMIN_SESSION_TOKEN=

# Bucket de Supabase Storage donde se guardan las fotos que subas desde el
# panel de admin. Debe existir y estar marcado como público.
SUPABASE_STORAGE_BUCKET=product-images
